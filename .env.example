# Public application URL used for Paystack callback links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Add a test key first. Keep secret keys server-side and never prefix them NEXT_PUBLIC_.
PAYSTACK_SECRET_KEY=
PAYSTACK_WALLET_ENABLED=false

# Configure after deployment:
# Callback: https://YOUR_DOMAIN/payment/paystack/callback
# Webhook:  https://YOUR_DOMAIN/api/payments/paystack/webhook
